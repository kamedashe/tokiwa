// PostgreSQL и локально, и в проде — одна база на оба окружения, чтобы не
// ловить расхождения. Главное из них: в SQLite оператор LIKE не различает
// регистр, а в PostgreSQL различает, поэтому поиск, работавший локально,
// в проде молча переставал находить. Теперь такого класса ошибок нет.
//
// Бесплатный тариф Neon даёт ветки — удобно держать отдельную для разработки.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Приложение ходит через пулер: serverless-функции открывают много коротких
  // соединений, и без пулера база быстро упирается в лимит.
  url = env("DATABASE_URL")

  // Миграции — напрямую, мимо пулера. В transaction mode PgBouncer не даёт
  // держать блокировки и сессионное состояние, без которых миграции не
  // отрабатывают.
  directUrl = env("DIRECT_URL")
}

model Title {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  malId     Int?    @unique
  anilistId Int?    @unique

  title    String
  /// Русское название с Shikimori. Показываем его, когда оно есть.
  titleRu  String?
  titleJp  String?
  synopsis String?

  posterUrl String?
  bannerUrl String?
  /// Оттенок (0-360) для градиента-заглушки, когда постера нет.
  hue       Int     @default(210)

  year          Int?
  season        String? // winter | spring | summer | fall
  format        String? // TV | ONA | Movie | OVA
  status        String? // releasing | finished | not_yet_aired
  score         Float?
  episodesCount Int?

  /// Сколько серий уже вышло у онгоинга и когда следующая — топливо для
  /// «вышли новые серии» в списке пользователя. Обновляется ночным кроном.
  episodesAired Int?
  nextEpisodeAt DateTime?

  /// Ручные флаги для главной — что попадает в hero и в «Сейчас в тренде».
  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)

  /// Длительность одной серии в минутах — основа расчёта времени на тайтл.
  durationMin Int?

  genres    Genre[]
  /// Тематические метки с Shikimori — см. модель Tag.
  tags      Tag[]
  watchlist WatchlistEntry[]

  /// Франшиза: сиквелы, приквелы, побочки и фильмы одного тайтла. Prisma
  /// хранит такую связь односторонне, поэтому для показа «рядом» страница
  /// собирает обе стороны — заносим только в related, читаем из обеих.
  related   Title[] @relation("TitleRelations")
  relatedBy Title[] @relation("TitleRelations")

  /// Когда последний раз тянули метки. null — ещё не ходили, поэтому обход
  /// возобновляется с места остановки, как и у relatedSyncedAt.
  tagsSyncedAt DateTime?

  /// --- Смысловой поиск ---
  ///
  /// Два вектора на тайтл: про что история и какая она.
  ///
  /// Один вектор обслуживал оба запроса сразу и шёл на компромисс: «что-нибудь
  /// тихое и уютное» — про настроение, оно в метках; «детектив расследует
  /// убийства в городке» — про сюжет, он в описании. Любая правка веса
  /// забирала у одного и отдавала другому, что и показали замеры составов
  /// v2–v5. Теперь они считаются раздельно, а смешиваются на запросе.
  ///
  /// halfvec(512) вместо vector(1024): по два байта на число вместо четырёх и
  /// вдвое меньше измерений (Voyage обучен матрёшкой, обрезание задумано
  /// авторами). Вектор весит килобайт вместо четырёх и умещается в самой
  /// строке, не уезжая в TOAST. Без этого два вектора просто не поместились
  /// бы: база упиралась в 460 МБ из 512 бесплатных.
  ///
  /// Тип Prisma не знает, поэтому Unsupported — в клиенте поля нет, читаем и
  /// пишем через $queryRaw. Схеме оно всё равно нужно: иначе migrate diff
  /// решит, что колонка лишняя, и сгенерирует DROP COLUMN.
  ///
  /// hnsw-индекса здесь намеренно нет. Смешанный порядок «столько-то тона плюс
  /// столько-то сюжета» индекс использовать не может в принципе — он умеет
  /// одну метрику, а не сумму двух. На 15 тысячах тайтлов честный перебор
  /// укладывается в десятки миллисекунд и точен, в отличие от hnsw.
  embedding     Unsupported("halfvec(512)")?
  embeddingTone Unsupported("halfvec(512)")?

  /// Хеш текста, который ушёл в модель, вместе с версией состава эмбеддинга.
  /// Прогон каталога считает хеш заново и трогает только те тайтлы, где он
  /// разошёлся, — иначе каждая правка состава стоила бы полного перегона.
  embeddingHash String?
  embeddedAt    DateTime?

  /// Когда последний раз тянули метаданные из Jikan — чтобы не дёргать API зря.
  syncedAt DateTime?
  /// Когда последний раз обходили связи. null — этот тайтл ещё не проверяли,
  /// благодаря чему обход возобновляется с места остановки.
  relatedSyncedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([year, season])
  @@index([score])
}

/// Курсор фоновых прогонов, которым некуда больше писать прогресс — сейчас
/// только "shikimoriPage": с какой страницы популярности продолжать в
/// следующий раз, чтобы кроном не топтаться по уже пройденному.
model SyncState {
  key   String @id
  value Int
}

/// Тематические метки Shikimori: kind theme и demographic (Iyashikei, Gore,
/// Time Travel, Isekai, Seinen) плюс жанры в свежем виде.
///
/// Почему отдельно от Genre, а не в него же: Genre питает публичные страницы
/// /genre/<slug> и фильтры каталога, они же лежат в sitemap. Свалить туда
/// «Gag Humor» — значит наплодить мусорных SEO-страниц. Здесь метки нужны
/// ровно для одного: они несут тон, которого нет в синопсисе, и без них
/// «что-нибудь тихое и грустное» ищется плохо.
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  /// Русское имя метки с Shikimori: «Iyashikei» → «Исцеляющее». Каталог и
  /// запросы русские, и на днях подбора состава это готовый рычаг —
  /// проверить, ищется ли лучше по-русски, не переобходя каталог заново.
  nameRu String?
  /// genre | theme | demographic — как их делит Shikimori.
  kind String

  titles Title[]

  @@index([kind])
}

model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  titles Title[]
}

/// Привязка Telegram-чата для уведомлений о новых сериях. Пока chatId пуст,
/// строка хранит одноразовый код с кнопки «Подключить» — бот обменяет его
/// на chatId при /start.
model TelegramLink {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Идентификаторы чатов Telegram не влезают в Int32.
  chatId        BigInt?   @unique
  code          String?   @unique
  codeExpiresAt DateTime?

  createdAt DateTime @default(now())
}

/// Отзывы пользователей — сырьё для решений, что внедрять, а что убирать.
/// Пишут только залогиненные: это отсекает ботов и даёт возможность ответить.
model Feedback {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- Аккаунты. Структура моделей задана Auth.js, менять поля нельзя. ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Анонимный посетитель, ведущий список без регистрации. Живёт за кукой
  /// браузера; при входе список переезжает в настоящий аккаунт, а эта
  /// строка удаляется. В продуктовой статистике такие не считаются.
  isGuest Boolean @default(false)

  /// Письма «вышли новые серии». Выключается ссылкой-отпиской из письма.
  emailNotifications Boolean @default(true)

  /// Когда ушёл последний недельный дайджест — антидубль: воскресный крон
  /// может не успеть всех за прогон и дошлёт хвост утром понедельника.
  digestSentAt DateTime?

  /// Поддержал проект на Boosty или Ko-fi. Ставится вручную скриптом
  /// (`npm run supporter`): публичного API подписок у Boosty нет, а на нашем
  /// масштабе список сторонников проще сверять глазами, чем строить обмен.
  isSupporter Boolean @default(false)
  /// Публичное имя в благодарностях. Пусто — значит просили не называть.
  supporterName String?

  accounts     Account[]
  sessions     Session[]
  watchlist    WatchlistEntry[]
  feedback     Feedback[]
  telegramLink TelegramLink?
  pushSubs     PushSubscription[]
  pollAnswers  PollAnswer[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Список пользователя: «смотрю» / «посмотрел» / «брошено» / «запланировано».
model WatchlistEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleId Int
  title   Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  status String @default("planned") // watching | completed | dropped | planned

  /// На какой серии остановились — для ряда «Продолжить просмотр».
  progress Int @default(0)

  /// До какой вышедшей серии уже уведомляли в Telegram — антидубль рассылки.
  notifiedEpisode Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один тайтл — одна запись на пользователя.
  @@unique([userId, titleId])
  @@index([userId, status, updatedAt])
}


/// Подписка браузера на пуш-уведомления.
///
/// Ключевое: привязана к User, а гость у нас — тоже User (isGuest), поэтому
/// пуши работают без регистрации. Это единственный канал возврата, доступный
/// тем, кто аккаунт заводить не хочет: почты у них нет, а браузер есть.
/// Одному человеку соответствует несколько подписок — по одной на устройство.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  /// Адрес, по которому push-сервис браузера принимает уведомления.
  endpoint String @unique
  /// Ключи шифрования из подписки — без них сообщение не зашифровать.
  p256dh   String
  auth     String

  /// Отвалившиеся подписки чистим по счётчику ошибок: браузер не сообщает
  /// об отписке, узнаём только по отказу при отправке.
  failures Int @default(0)

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ответы на короткие опросы в интерфейсе.
///
/// Первый вопрос — нужна ли гостю сохранность списка. Спросить дешевле, чем
/// гадать: три дня уговоров кнопками дали одну регистрацию на 35 гостей, и
/// непонятно, дело в подаче или сохранность им просто не нужна. Ответ заодно
/// решает, показывать ли человеку предложение войти.
model PollAnswer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ключ вопроса — чтобы задавать новые, не заводя таблицу под каждый.
  question String
  answer   String

  createdAt DateTime @default(now())

  /// Один ответ на вопрос от человека.
  @@unique([userId, question])
  @@index([question, answer])
}
